# ---------------------------------------------------------------------------
# Скопируйте в .env и заполните. Реальные секреты в репозиторий не коммитятся.
#
# Сгенерировать ключи:
#   openssl rand -base64 32     # SESSION_ENCRYPTION_KEY
#   openssl rand -hex 32        # JWT_SECRET
# ---------------------------------------------------------------------------

# --- Приложение ------------------------------------------------------------
APP_NAME=telegram-ai-platform
ENV=dev                        # dev | staging | prod
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | console
CORS_ORIGINS=http://localhost:3000
HTTP_PORT=8080

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=tgai
POSTGRES_PASSWORD=
POSTGRES_DB=tgai
POSTGRES_PORT=5433
# В docker compose DATABASE_URL подставляется автоматически из значений выше.
# Для запуска вне Docker раскомментируйте и укажите свой адрес:
# DATABASE_URL=postgresql+asyncpg://tgai:password@localhost:5433/tgai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6380
REDIS_MAXMEMORY=512mb
# REDIS_URL=redis://localhost:6380/0

# --- Безопасность ----------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
SECURE_COOKIES=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Ключ шифрования Telegram-сессий: 32 байта в base64 или hex.
# Храните вне БД и вне бэкапов базы, иначе шифрование теряет смысл.
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_ID=k1
# Выведенные из обращения ключи для расшифровки старых записей при ротации:
# SESSION_ENCRYPTION_KEYS_OLD=k0:BASE64KEY,k00:BASE64KEY

# Первичный администратор панели, создаётся при первом запуске.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Telegram --------------------------------------------------------------
# Собственные api_id / api_hash с https://my.telegram.org.
# Чужие credentials (в том числе «публичные» от Telegram Desktop) использовать
# нельзя: это нарушение ToS и частая причина блокировки аккаунта.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DEVICE_MODEL=TG AI Platform
TELEGRAM_APP_VERSION=1.0
TELEGRAM_CONNECT_TIMEOUT=15
# Минимальный интервал между отправками одного аккаунта — защита аккаунта от
# FloodWait, а не средство обхода ограничений Telegram.
SEND_MIN_INTERVAL_SECONDS=3
FLOOD_WAIT_MAX_SECONDS=600
# Максимальный размер загружаемой папки tdata.
TDATA_MAX_UPLOAD_MB=64

# --- AI --------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # для OpenAI-совместимых провайдеров
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_AI_TEMPERATURE=0.6
DEFAULT_AI_MAX_TOKENS=600
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENCY=8
AI_DAILY_BUDGET_USD=0            # 0 = без ограничения
# Цены модели для учёта расходов (0 = не считать деньги, только токены).
AI_PRICE_INPUT_PER_1M_USD=0
AI_PRICE_OUTPUT_PER_1M_USD=0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Обработка сообщений ---------------------------------------------------
MAX_CONTEXT_MESSAGES=20
MAX_MESSAGE_LENGTH=4000
DEFAULT_COOLDOWN_SECONDS=600
MAX_CONSECUTIVE_AI_REPLIES=3
SUMMARY_EVERY_N_MESSAGES=15
DUPLICATE_WINDOW_SECONDS=86400

# --- База знаний -----------------------------------------------------------
KB_MAX_FILE_SIZE_MB=20
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_SIMILARITY_THRESHOLD=0.75
KB_MAX_CHUNKS=5

# --- Воркеры ---------------------------------------------------------------
WORKER_NAME=worker-1
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_AFTER_SECONDS=45
ACCOUNT_LEASE_TTL_SECONDS=30
WORKER_MAX_ACCOUNTS=25

# --- Хранение данных -------------------------------------------------------
MESSAGE_RETENTION_DAYS=90
EVENT_LOG_RETENTION_DAYS=30
